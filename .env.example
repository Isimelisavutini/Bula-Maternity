UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-in-vercel-settings
SESSION_SECRET=generate-a-long-random-secret

# Production mobile/web data plane. Never expose the service-role key to a client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-in-vercel-settings
NEXT_PUBLIC_IOS_APP_DOWNLOAD_URL=https://apps.apple.com/app/your-carefiji-app-id

# Verified maternity contact number for the care-pod emergency call button.
# Leave unset until your clinic supplies the correct number; never use a demo number.
# NEXT_PUBLIC_MATERNITY_TRIAGE_PHONE=configure-with-your-clinic

# Set on Vercel only AFTER the Azure API /health/ready check passes.
# Leave unset during the staged migration to retain the legacy API fallback.
# Local web development against C#: http://127.0.0.1:5080
BACKEND_API_URL=https://your-api.azurewebsites.net
