# These are Azure App Service environment settings. For local use, export them
# in the shell; ASP.NET Core does not load .env files automatically.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:5080
SESSION_SECRET=use-the-existing-demo-session-secret-to-preserve-sessions
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=configure-securely
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# Application Insights is configured by the Azure infrastructure template.
